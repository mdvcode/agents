{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "kind", "experiment_id", "baseline", "candidate", "datasets", "thresholds"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "evaluation_experiment"},
    "experiment_id": {"type": "string", "minLength": 1},
    "baseline": {"type": "object"},
    "candidate": {"type": "object"},
    "datasets": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "thresholds": {
      "type": "object",
      "required": ["minimum_overall_score", "minimum_coverage", "maximum_regression", "critical_metrics"],
      "properties": {
        "minimum_overall_score": {"type": "number", "minimum": 0, "maximum": 1},
        "minimum_coverage": {"type": "number", "minimum": 0, "maximum": 1},
        "maximum_regression": {"type": "number", "minimum": 0, "maximum": 1},
        "critical_metrics": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
