{
  "type": "object",
  "required": ["version", "project", "runtime"],
  "properties": {
    "version": {"type": "integer", "enum": [1]},
    "project": {
      "type": "object",
      "required": ["id", "profile", "repository", "base_branch", "branch_prefix"],
      "properties": {
        "id": {"type": "string"},
        "profile": {"type": "string", "enum": ["agent_workspace", "django", "nextjs_web"]},
        "repository": {"type": "string", "enum": ["."]},
        "base_branch": {"type": "string"},
        "branch_prefix": {"type": "string"}
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "required": ["provider"],
      "properties": {
        "provider": {"type": "string", "enum": ["codex-sdk", "codex-cli"]}
      },
      "additionalProperties": false
    },
    "attachments": {
      "type": "object",
      "properties": {
        "max_files": {"type": "integer", "minimum": 1, "maximum": 5},
        "max_file_bytes": {"type": "integer", "minimum": 1, "maximum": 536870912},
        "max_task_bytes": {"type": "integer", "minimum": 1, "maximum": 2684354560}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
