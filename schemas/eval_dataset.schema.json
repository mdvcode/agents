{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "name", "cases"],
  "properties": {
    "schema_version": {"const": 1},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "subject", "expectations"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "subject": {"type": "string", "minLength": 1},
          "tags": {"type": "array", "items": {"type": "string"}},
          "expectations": {
            "type": "object",
            "properties": {
              "minimum_overall_score": {"type": "number", "minimum": 0, "maximum": 1},
              "minimum_coverage": {"type": "number", "minimum": 0, "maximum": 1},
              "required_metrics": {"type": "array", "items": {"type": "string"}},
              "minimum_metric_scores": {
                "type": "object",
                "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
